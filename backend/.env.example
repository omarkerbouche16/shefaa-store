ENVIRONMENT=production
PROJECT_NAME=Shefaa API
BACKEND_CORS_ORIGINS=["https://shefaa.shop","https://admin.shefaa.shop"]
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/shefaa_webset

# ── Integrations ──────────────────────────────────────────────────────────────
GOOGLE_SHEET_WEBHOOK_URL=
META_PIXEL_ID=
META_ACCESS_TOKEN=
META_TEST_EVENT_CODE=
TIKTOK_PIXEL_CODE=
TIKTOK_ACCESS_TOKEN=
SNAP_PIXEL_ID=
SNAP_ACCESS_TOKEN=
SUPABASE_JWT_SECRET=

# ── IP Fraud / Geo-validation ─────────────────────────────────────────────────
# MaxMind GeoIP2 Web Service — https://www.maxmind.com/en/geolite2/signup
MAXMIND_ACCOUNT_ID=123456
MAXMIND_LICENSE_KEY=your_license_key_here

# IP Quality Score (second VPN detection layer) — https://www.ipqualityscore.com/
IPQS_API_KEY=your_ipqs_key_here

# Comma-separated phones that bypass IP fraud checks (for internal testing)
WHITELISTED_PHONES=055000000

# ── Admin Dashboard ───────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose_a_strong_password_here
# Must be a long random string — used to sign JWT tokens
ADMIN_JWT_SECRET=change-me-to-a-random-64-char-string
# How many hours the admin token stays valid (default 8)
ADMIN_JWT_EXPIRE_HOURS=8
